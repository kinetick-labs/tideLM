# GLM-5.3-Flash 2.48bpw SAGE-REXL3 on ONE DGX Spark (TP=1): vcruz305/GLM-5.3-Flash-SAGE-REXL3-2.48bpw
# (rev 7d0de24) - the 3.5bpw checkpoint with its routed experts at 2.48 bits (SAGE, binary triples),
# its non-expert weights left EXL3 and served NATIVELY: GLM_FLASH_DENSE=exl3. No second checkpoint,
# no dense download, no FP8/bf16 round-trip: the pack is the only thing on disk (97.4 GB). ~60% of
# the routed experts resident (the 4 bpw profile's budget), the rest read on demand from one pack.
# No PEER: one box. TP=2 is NOT supported in this mode (docs/glm-flash.md, the reason is the fused
# projections' RowStack).
# Start: cp configs/glm53-flash-248-exl3.env.example .env.glm53-flash-248, edit the paths, then
# scripts/tide.sh start .env.glm53-flash-248    Stop: scripts/tide.sh stop
#
# Setup (docs/glm-flash.md, "A checkpoint that quantises its own non-expert weights"): the pack only.
#   uv run --no-project --with numpy python tools/glm_pack_exl3.py --world 1 --resume --verify 64 \
#       --repo vcruz305/GLM-5.3-Flash-SAGE-REXL3-2.48bpw --revision 7d0de24624020fc4f07923572be2cef591a4d1ed \
#       --out <packs dir>/glm-flash-248-r0of1.bin                            # 97.4 GB, straight from the Hub
# A quantization_config.json beside config.json is read for the codebook (this checkpoint publishes
# quant_method only).
GLM_MODEL_DIR=/home/you/models/GLM-5.3-Flash-SAGE-REXL3-2.48bpw
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash
GLM_MAX_SEQ=327680
# requests served at once over one paged KV pool (each lane ~0.74 GB: its KDA state 0.3, the state at
# its last prompt's end for the next turn 0.3, rollback rows 0.07). Measured 2026-11-21 on one box:
# engine up in 44 s, device 102.34 GiB at boot on the 121.6 GiB box, 12.4 GiB MemAvailable left
# (tools/mem_watch.sh, 300 s, idle and under load) where the TensorFold server at 262,144 positions
# leaves 3.7-3.9 GiB. The KV pool is 2.24 GB a rank at 327,680 positions. Each 1 GB is ~110 3-bit
# slots; memguard stops the server under 4 GiB.
GLM_LANES=2
GLM_LANE_CHUNK=1024
GLM_KV=fp8
GLM_KV_SPLIT=0
# a memory budget in 3-bit records at Flash's dims (9.47 MB each). 9700 is the 4 bpw profile's
# budget carried over, not re-sized for 2.48-bit records (this boot's 12.4 GiB free is with it);
# raise it only with tools/mem_watch.sh watching, and its 4 GiB floor still holds.
GLM_SLOTS=9700
# the non-expert weights served in EXL3 natively - the reason this profile exists. flash.rs reads
# the checkpoint's own .trellis/.suh/.svh/.mul1 matrices for every non-expert tensor instead of a
# BF16 checkpoint it would quantise to FP8: lm_head, both o_proj, the dense layers' and the shared
# experts' gate|up and down, eh_proj, q_b/wq_b, and the router (F16 here). F16/F32 small tensors
# (norms, the mHC coefficients, kv_b_proj) are widened on read. The checkpoint is served as it is.
GLM_FLASH_DENSE=exl3
GLM_EXPERT_FORMAT=exl3
GLM_EXL3_DIR=/home/you/models/glm-flash-packs
GLM_EXL3_PACK=/packs/glm-flash-248-r{rank}of1.bin
GLM_HEAD=exl3
GLM_KVB_FP8=1
GLM_EMBED_8BIT=int8
GLM_CHUNK=4096
GLM_PREFILL_REDUCE=bf16
# bench/bench.py on the boot above (1024 tokens, temperature 0.6, median of 3): prose 27.11 tok/s,
# code 35.04, prefill 6,830 tokens in 10.0 s (682 tok/s), 27,290 in 37.5 s (727 tok/s). The same boot
# with the hybrid (GLM_FLASH_DENSE=fp8 against a second checkpoint's BF16 dense weights): 26.09 /
# 32.75 tok/s, 10.57 s / 40.5 s - so the native path is +3.9% prose, +7% code, +5% prefill AND frees
# the 19 GB dense download.
# the routing history: its own state file (the router's, never shared across checkpoints), seeded at
# first boot from GLM_STATS_DB.
RUST_GLM_STATE_DB=/home/you/tidelm-rust-state/glm-flash-248-stats.npz
# the bundled seed, read only when the state file does not exist yet: v1 is a day of serving on the
# development box (2.9M routed rows: chat, benches, long-prompt tests; profiles/glm53-flash-history-v1.json).
GLM_STATS_DB=/app/profiles/glm53-flash-history-v1.npz
# the disk prefix store holds KV rows, not KDA's state: off (the engine skips it for this model)
GLM_PREFIX_DISK=0
# MTP: up to 7 drafts a round, the chain stopped on the calibrated acceptance (GLM-5.3's setting).
# GLM_DRAFT_VOCAB (the listed-vocabulary draft head) is OFF in this mode and its setting is not read:
# it gathers rows of lm_head as BF16 and an EXL3 head cannot be gathered that way. The draft passes
# then score every id (the verifier always did), so it costs draft speed, not correctness.
GLM_MTP=1
GLM_MTP_DEPTH=7
GLM_MTP_CAL=0.36
GLM_MTP_DYN=0.9
GLM_COPY=1
GLM_LOOKUP=8
GLM_ADAPT=1
GLM_ADAPT_EVERY=200
GLM_ADAPT_PREFILL_SWAPS=512
GLM_ADAPT_DECODE_SWAPS=256
GLM_HOT=1
GLM_HOT_KEEP=32
GLM_HOT_ASYNC=1
# Inline rescue (GLM_HOT_ASYNC=1 only), the 4 bpw profile's value: 0.3 since 2026-11-18 (it was 0.4).
GLM_HOT_RESCUE=0.3
GLM_BG=1
GLM_BG_EVERY=2
GLM_REASONING_EFFORT=low
GLM_DEFAULT_MAX_TOKENS=32768
# image input: the checkpoint's vision tower is BF16 and loads as the 4 bpw one does, on demand into
# expert slots lent for the request; an image is resized to at most this many tokens (one a 28 x 28
# pixel cell; the processor's own cap, 8000)
GLM_VISION=1
GLM_VISION_MAX_TOKENS=8000
# DFlash2 is off. The block that measured accept 1.04 was not the algorithm the checkpoint was
# trained for (docs/dflash2-campaign.md, the addendum). To measure the fix, set both of these
# and keep the MTP depth so the verify window exists. Copy and lookup draft instead of it when
# they are on, so turn them off for the acceptance run:
#   GLM_DRAFTER=dflash2
#   GLM_DRAFTER_DIR=/home/you/models/glm53-dflash2
#   GLM_COPY=0
#   GLM_LOOKUP=0
# Leave GLM_MTP=1 and GLM_MTP_DEPTH=7. The boot line is "boot: DFlash2 drafter". A request's
# line reports "drafted / accepted a round"; the anchor is the extra token, so tokens a step
# is one more than accepted. DF_CAND=1 prints the first drafted row's 16 candidates once.
